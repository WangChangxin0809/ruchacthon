  "cards": [
    {
      "dot": "rose",
      "title": "三条硬规则",
      "items": [
        "同工作区抢同一路径 → 升级给人，worker 阻塞到有裁决为止",
        "每一次模型调用都走 cc_runner，没有第二个客户端",
        "密钥只按环境变量名引用，不进响应、日志、事件、数据库"
      ]
    },
    {
      "dot": "cyan",
      "title": "工作逻辑",
      "items": [
        "主 agent 派活，worker 各自一个 worktree 后台跑",
        "看板四列跟进：需要你 / 进行中 / 待审阅 / 待合并",
        "审阅通过 ≠ 合并，合并是人单独按的一步"
      ]
    },
    {
      "dot": "emerald",
      "title": "已经验证过的",
      "items": [
        "转换代理端到端：claude -p → 回环 → NVIDIA NIM，3.7 秒返回",
        "schema 1→3 迁移先在生产库副本上彩排，再上线",
        "会话可见性：非成员拿不到消息、成果与事件"
      ]
    }
