
# Personal permission grants. Committed, they apply to everyone who clones.
.claude/settings.local.json

# Python leaves these behind the moment a hook or a gate runs.
__pycache__/
*.pyc

# AgentRoom runtime state -- regenerated by running the backend, not source.
# (SQLite is now the single source of truth; jsonl files no longer exist,
# left here in case an old checkout still has some lying around.)
backend/data/*.jsonl
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# Local dev environment bootstrapped inside the sandbox (no apt access to
# python3-venv/nodejs, see backend/README.md and frontend/README.md).
.venv/
.local/opt/
frontend/node_modules/

